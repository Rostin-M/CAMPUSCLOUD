# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_DB=campuscloud
POSTGRES_USER=campuscloud
POSTGRES_PASSWORD=campuscloud

# For local docker-compose these default to the local `db` service above.
# For production, point these at your real database (Neon, Railway, etc).
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/campuscloud
SPRING_DATASOURCE_USERNAME=campuscloud
SPRING_DATASOURCE_PASSWORD=campuscloud

RECAPTCHA_SECRET=
